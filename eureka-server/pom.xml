<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot'un hazir ayarlarini miras aliyoruz (parent). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.proje</groupId>
    <artifactId>eureka-server</artifactId>
    <version>1.0.0</version>
    <name>eureka-server</name>
    <description>Servis kesif sunucusu (Service Discovery)</description>

    <properties>
        <!-- Java 17 kullaniyoruz. -->
        <java.version>17</java.version>
        <!-- Eureka, Spring Cloud ailesinden gelir; surumunu burada sabitliyoruz. -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <!-- Override GERI KONDU: 10.1.55'te dort CVSS 9.1 var (CVE-2026-53434,
             CVE-2026-55276, CVE-2026-59083, CVE-2026-59084) ve son ikisi ancak
             10.1.57'de kapaniyor.
             KALDIRMA KOSULU: Boot'un surum tablosu 10.1.57'yi gectiginde. -->
        <tomcat.version>10.1.57</tomcat.version>
        <!-- CVE-2026-71290 (9.1): async HttpClient'ta TLS sunucu adi
             dogrulamasi etkisiz; 5.6.4 duzeltiyor. -->
        <httpclient5.version>5.6.4</httpclient5.version>
        <!-- httpcore5 istemciyle BIRLIKTE yukseltilir; ayrisirlarsa calisma
             zamaninda NoClassDefFoundError firliyor. Gerekce
             employee-service/pom.xml'de. -->
        <httpcore5.version>5.4.3</httpcore5.version>

        <dependency-check.version>12.1.3</dependency-check.version>
    </properties>

    <dependencies>
        <!-- Eureka Server'i getiren tek bagimlilik. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>

        <!-- Saglik ucu. Panelin cevap vermesi canlilik sinyalidir ama servisin
             KENDINI saglikli sayip saymadigini soylemez; orkestratorun sordugu
             sorunun cevabi budur. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <!-- Spring Cloud surumlerini uyumlu tutan BOM (Bill of Materials). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Bagimlilik aciklari. Yasam dongusune BAGLI DEGIL: acikca
                 cagrilinca calisir (mvn dependency-check:check), boylece gunluk
                 test kosusu yavaslamaz. Ilk kosu NVD veritabanini indirir.
                 NVD_API_KEY tanimliysa cok daha hizlidir; anahtarsiz da calisir. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <!-- Bu projede .NET ve Node yok; arayuz npm audit ile bakiliyor. -->
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                    <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                    <!-- Sonatype OSS Index artik anonim istege 401 donuyor ve
                         cozumleyici hatasi TARAMAYI DUSURUYORDU. Kapali: veri
                         kaynagimiz NVD. Hesap alinirsa geri acilabilir. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <!-- Kritik bulgu goruldugunde tarama DUSER. Esigin gerekcesi
                         ve sikilastirma kosulu employee-service/pom.xml'de. -->
                    <failBuildOnCVSS>9</failBuildOnCVSS>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                </configuration>
            </plugin>
            <!-- "mvn spring-boot:run" ve calistirilabilir jar icin. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- build-info: derleme sirasinda surum, artifact ve zaman
                         damgasini META-INF'e yazar; /actuator/info bunu doner.
                         Onceden uc ACIKTI ama BOSTU: calisan bir konteynere
                         "sen hangi surumsun" diye sorulamiyordu. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

