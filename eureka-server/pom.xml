<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot'un hazir ayarlarini miras aliyoruz (parent). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.proje</groupId>
    <artifactId>eureka-server</artifactId>
    <version>1.0.0</version>
    <name>eureka-server</name>
    <description>Servis kesif sunucusu (Service Discovery)</description>

    <properties>
        <!-- Java 17 kullaniyoruz. -->
        <java.version>17</java.version>
        <!-- Eureka, Spring Cloud ailesinden gelir; surumunu burada sabitliyoruz. -->
        <spring-cloud.version>2023.0.1</spring-cloud.version>
    </properties>

    <dependencies>
        <!-- Eureka Server'i getiren tek bagimlilik. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>

        <!-- Saglik ucu. Panelin cevap vermesi canlilik sinyalidir ama servisin
             KENDINI saglikli sayip saymadigini soylemez; orkestratorun sordugu
             sorunun cevabi budur. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <!-- Spring Cloud surumlerini uyumlu tutan BOM (Bill of Materials). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- "mvn spring-boot:run" ve calistirilabilir jar icin. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- build-info: derleme sirasinda surum, artifact ve zaman
                         damgasini META-INF'e yazar; /actuator/info bunu doner.
                         Onceden uc ACIKTI ama BOSTU: calisan bir konteynere
                         "sen hangi surumsun" diye sorulamiyordu. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
