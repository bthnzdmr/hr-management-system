# Bu dosya .env icin sablondur ve GERCEK DEGER ICERMEZ.
#
# Kurulum:
#   1. Bu dosyayi .env adiyla kopyala
#   2. Asagidaki degerleri doldur (yerel makinende istedigin degeri secebilirsin)
#
# .env dosyasi .gitignore'dadir, depoya girmez.
#
# Iki yerde birden kullanilir:
#   - docker compose up -d  ->  PostgreSQL ve RabbitMQ bu degerlerle kurulur
#   - uygulama              ->  ayni degerlerle baglanir


# ---------- PostgreSQL ----------
POSTGRES_DB=employee_db
DB_USERNAME=
DB_PASSWORD=


# ---------- RabbitMQ ----------
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=


# ---------- Uygulama ----------
# Ilk yonetici hesabi. Bos birakilirsa hesap olusturulmaz ve hicbir uca
# giris yapilamaz.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Salt okuyan insan hesabi. Rolu EMPLOYEE: YALNIZCA kendi kaydini gorur.
# Demo veride Ada Lovelace'e baglanir. Bos birakilirsa olusturulmaz.
USER_EMAIL=
USER_PASSWORD=

# Notification Service'in Employee Service'i cagirirken kullandigi hesap.
# Rolu SERVICE'tir: rehberi okur, veri degistiremez. Rol her acilista
# dogrulanip duzeltilir -- makine kimliginin rolu veri degil yapilandirmadir.
# Iki servis de ayni degerleri okur.
SERVICE_ACCOUNT_EMAIL=
SERVICE_ACCOUNT_PASSWORD=

# ---------- Rol basina demo hesaplari ----------
# Her rolu AYRI AYRI denemek icin; hicbiri zorunlu degildir ve uretimde
# tanimlanmamalari beklenir. Ilk hesap iki rolu birden tasidigi icin
# (HR_SPECIALIST + SYSTEM_ADMIN) rol ayrimi onunla gorulemez.
#
#   Yonetici     : kendini ve DOGRUDAN astlarini gorur (torunlari degil).
#   Ik uzmani    : personel ve izin yazar, HESAP yonetemez, ucrete DOKUNAMAZ.
#   Sistem yon.  : hesap ve rol yonetir, personel duzenleyemez, maasi GOREMEZ.
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=

DEMO_HR_EMAIL=
DEMO_HR_PASSWORD=

DEMO_SYSADMIN_EMAIL=
DEMO_SYSADMIN_PASSWORD=

#   Bordro uzm.  : ucreti okur ve yazar, personel kaydi ACAMAZ.
DEMO_PAYROLL_EMAIL=
DEMO_PAYROLL_PASSWORD=

# JWT imzalama anahtari. BASE64 kodlu ve en az 32 bayt olmalidir.
# Uretmek icin:
#   Linux / macOS   : openssl rand -base64 48
#   Windows (PS)    : [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=

# Gelistirme ve tanitim icin gercekci bir organizasyon uretir (37 kayit).
# Uretimde ASLA acilmaz.
DEMO_DATA=false

# ---------- Ortam ve gunlukleme ----------
# Bos birakilirsa uygulama URETIM-GUVENLI varsayilanlarla acilir: log sessiz,
# API semasi kapali, JSON bicimli gunluk. Compose'un "full" profili bunu
# kendiliginden "dev" yapar (yerel gelistirme yigini).
SPRING_PROFILES_ACTIVE=

# API semasini disariya acar. /v3/api-docs kimlik dogrulamasi ISTEMEZ, yani
# acik oldugunda butun uclar ve DTO alanlari herkese gorunur.
SWAGGER_ENABLED=false

# Gunluk seviyeleri. dev profili bunlari zaten debug'a ceker.
APP_LOG_LEVEL=info
SQL_LOG_LEVEL=warn

# Basarisiz giris denemesi siniri ve bloke suresi (saniye).
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_SECONDS=300
