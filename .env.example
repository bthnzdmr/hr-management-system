# Bu dosya .env icin sablondur ve GERCEK DEGER ICERMEZ.
#
# Kurulum:
#   1. Bu dosyayi .env adiyla kopyala
#   2. Asagidaki degerleri doldur (yerel makinende istedigin degeri secebilirsin)
#
# .env dosyasi .gitignore'dadir, depoya girmez.
#
# Iki yerde birden kullanilir:
#   - docker compose up -d  ->  PostgreSQL ve RabbitMQ bu degerlerle kurulur
#   - uygulama              ->  ayni degerlerle baglanir


# ---------- PostgreSQL ----------
POSTGRES_DB=employee_db
DB_USERNAME=
DB_PASSWORD=


# ---------- RabbitMQ ----------
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=


# ---------- Uygulama ----------
# Ilk yonetici hesabi. Bos birakilirsa hesap olusturulmaz ve hicbir uca
# giris yapilamaz.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Salt okuyan insan hesabi. Rolu EMPLOYEE: YALNIZCA kendi kaydini gorur.
# Demo veride Ada Lovelace'e baglanir. Bos birakilirsa olusturulmaz.
USER_EMAIL=
USER_PASSWORD=

# Notification Service'in Employee Service'i cagirirken kullandigi hesap.
# Rolu SERVICE'tir: rehberi okur, veri degistiremez. Rol her acilista
# dogrulanip duzeltilir -- makine kimliginin rolu veri degil yapilandirmadir.
# Iki servis de ayni degerleri okur.
SERVICE_ACCOUNT_EMAIL=
SERVICE_ACCOUNT_PASSWORD=

# ---------- Rol basina demo hesaplari ----------
# Her rolu AYRI AYRI denemek icin; hicbiri zorunlu degildir ve uretimde
# tanimlanmamalari beklenir. Ilk hesap iki rolu birden tasidigi icin
# (HR_SPECIALIST + SYSTEM_ADMIN) rol ayrimi onunla gorulemez.
#
#   Yonetici     : kendini ve DOGRUDAN astlarini gorur (torunlari degil).
#   Ik uzmani    : personel ve izin yazar, HESAP yonetemez, ucrete DOKUNAMAZ.
#   Sistem yon.  : hesap ve rol yonetir, personel duzenleyemez, maasi GOREMEZ.
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=

DEMO_HR_EMAIL=
DEMO_HR_PASSWORD=

DEMO_SYSADMIN_EMAIL=
DEMO_SYSADMIN_PASSWORD=

#   Bordro uzm.  : ucreti okur ve yazar, personel kaydi ACAMAZ.
DEMO_PAYROLL_EMAIL=
DEMO_PAYROLL_PASSWORD=

# JWT imzalama anahtari. BASE64 kodlu ve en az 32 bayt olmalidir.
# Uretmek icin:
#   Linux / macOS   : openssl rand -base64 48
#   Windows (PS)    : [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=

# Gelistirme ve tanitim icin gercekci bir organizasyon uretir (37 kayit).
# Uretimde ASLA acilmaz.
DEMO_DATA=false

# ---------- Ortam ve gunlukleme ----------
# Bos birakilirsa uygulama URETIM-GUVENLI varsayilanlarla acilir: log sessiz,
# API semasi kapali, JSON bicimli gunluk. Compose'un "full" profili bunu
# kendiliginden "dev" yapar (yerel gelistirme yigini).
SPRING_PROFILES_ACTIVE=

# API semasini disariya acar. /v3/api-docs kimlik dogrulamasi ISTEMEZ, yani
# acik oldugunda butun uclar ve DTO alanlari herkese gorunur.
SWAGGER_ENABLED=false

# Gunluk seviyeleri. dev profili bunlari zaten debug'a ceker.
APP_LOG_LEVEL=info
SQL_LOG_LEVEL=warn

# Basarisiz giris denemesi siniri ve bloke suresi (saniye).
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_SECONDS=300

# Yillik izin. Kidem merdiveni bir LISTE oldugu icin buradan degil
# application.yml'den okunur; burasi yalnizca iki skaleri tasir.
#
# Varsayilan gun, hak satiri OLMAYAN yillar icin gecerlidir (tahakkuk isinden
# onceki yillar). Devir tavani, kullanilmayan gunlerin bir sonraki yila
# tasinma sinirdir.
LEAVE_DEFAULT_ANNUAL_DAYS=20
LEAVE_CARRY_OVER_CAP=5

# CSV disari aktarma tavani. Sayfa tavani (max-page-size: 100) toplu
# sizdirmayi kapatmak icin konmustu; aktarma o kapiyi yalnizca Ik'ya acik ve
# DENETLENEN bir yoldan genisletiyor. Asilirsa dosya kirpilmaz, istek 409
# ile reddedilir.
EXPORT_MAX_ROWS=5000

# Parola sifirlama. Kisa omur, jetonun outbox satirinda duz metin durmasinin
# penceresini de kapatir.
PASSWORD_RESET_VALIDITY_MINUTES=30
INVITE_VALIDITY_HOURS=24
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=120

# Sifirlama mailindeki baglantinin gosterdigi arayuz adresi. Gercek bir
# dagitimda MUTLAKA degistirilir; yoksa kullaniciya calismayan baglanti gider.
APP_BASE_URL=http://localhost:5173

# ---------- Istege bagli: ayarlanabilir davranis ----------
# Hicbiri zorunlu degil; varsayilanlari docker-compose.yml icinde yazili.

# Idempotency penceresi. Bir mesajin broker'da bekleyebilecegi en uzun
# sureden GUVENLE uzun olmali; erken silme mukerrer mail uretir.
PROCESSED_EVENT_RETENTION_DAYS=30
PROCESSED_EVENT_CLEANUP_INTERVAL_MS=3600000

# SQL loglama. Varsayilan sessiz: OutboxRelay iki saniyede bir yokluyor ve
# acik birakilirsa gercek olaylar gurultude kaybolur.
#   SQL_LOG_LEVEL=debug SQL_FORMAT=true docker compose --profile full up -d
SQL_FORMAT=false

# Vekil basliklarina guvenilsin mi? Yalnizca uygulama bir vekilin ARKASINDA
# ve dogrudan erisilemiyorsa 'framework' yapin: aksi halde istemci kendi
# X-Forwarded-For'unu yazip IP hiz sinirini atlar.
FORWARD_HEADERS_STRATEGY=none

# Arayuzun cagirdigi adres. Build ZAMANINDA koda gomulur ve istegi yapan
# tarayicidir: konteyner agindaki servis adi burada CALISMAZ.
VITE_API_URL=http://localhost:8080

# CORS bir TARAYICI korumasidir; "*" hem kimlik bilgisi tasiyan istekte
# reddedilir hem de her siteye API'yi acardi.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Ikinci bir yigin (uctan uca testler) icin ad ve port onekleri.
# Gunluk kullanimda ELLENMEZ; degerleri .env.e2e tasir.
STACK_PREFIX=hr
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_PANEL_PORT=15672
MAILHOG_SMTP_PORT=1025
MAILHOG_PANEL_PORT=8025
EUREKA_PORT=8761
EMPLOYEE_PORT=8080
