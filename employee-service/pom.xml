<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent, yuzlerce kutuphanenin birbiriyle uyumlu SURUMLERINI tutan tablodur.
         Asagidaki bagimliliklarda <version> yazmiyoruz; Maven sürümü buradan okur. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.proje</groupId>
    <artifactId>employee-service</artifactId>
    <version>1.0.0</version>
    <name>employee-service</name>
    <description>Employee CRUD service (single source of truth for employee data)</description>

    <properties>
        <java.version>17</java.version>
        <!-- Spring Cloud ayri bir surum ailesidir; kendi tablosu asagida import ediliyor. -->
        <spring-cloud.version>2023.0.5</spring-cloud.version>
        <!-- springdoc Spring Boot ekibinin urunu degil; parent'in surum tablosunda yok. -->
        <springdoc.version>2.5.0</springdoc.version>
        <!-- jjwt de parent tarafindan yonetilmiyor. -->
        <jjwt.version>0.12.5</jjwt.version>
        <!-- Guvenlik taramasi eklentisi; parent tarafindan yonetilmiyor. -->
        <dependency-check.version>12.1.3</dependency-check.version>
        <!-- Spring Boot 3.2.5'in getirdigi Tomcat 10.1.20'de CVSS 9+ on dort
             acik vardi (RCE'ler dahil). Boot sabit kaliyor; yalnizca konteyner
             yamali hatta cekildi. Olculdu: kritikler 17'den 6'ya indi. -->
        <tomcat.version>10.1.55</tomcat.version>
    </properties>

    <dependencies>

        <!-- 1) REST: HTTP alip JSON donmek.
             Icinde gomulu Tomcat, Spring MVC ve Jackson (Java <-> JSON) gelir. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 2) Veritabani erisimi: JPA/Hibernate ve transaction yonetimi.
             JPA hangi veritabani oldugunu BILMEZ; o isi asagidaki surucu yapar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 2b) PostgreSQL surucusu (driver): JPA'nin urettigi cagrilari
             PostgreSQL'in anladigi protokole cevirir.
             runtime kapsami: derlerken gerekmez, sadece calisirken gerekir. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 3) Versiyonlu sema yonetimi.
             Uygulama acilirken db/migration altindaki SQL dosyalarini sirayla calistirir. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- 4) Girdi dogrulama: @NotBlank, @Email, @Size gibi anotasyonlar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 5) Eureka'ya kaydolmak. Sunucu tarafi rehberi TUTAR, istemci rehbere KAYDOLUR. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- 6) AOP: kesisen ilgileri (sure olcumu, loglama) is kodundan ayirmak icin. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 7) OpenAPI/Swagger: belge koddan uretilir, elle yazilmaz. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- 8) Actuator: saglik ucu. Orkestratör ve yuk dengeleyici bunu sorar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- Micrometer'in Prometheus bicimi. runtime: kod bu kutuphaneye
                 hic bakmaz, yalnizca /actuator/prometheus ucunu var eder. -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 9) Kimlik dogrulama ve yetkilendirme. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 10) JWT uretme ve dogrulama.
             api derleme zamaninda, impl ve jackson yalnizca calisma aninda gerekir. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 11) RabbitMQ: olaylarin yayinlanmasi. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Test: JUnit 5, Mockito, AssertJ, MockMvc.
             test kapsami: yalnizca test derlerken ve calisirken kullanilir,
             uretim jar'ina girmez. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @WithMockUser gibi test yardimcilari. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- Spring Cloud'un surum tablosu (BOM = Bill of Materials).
         parent Spring Boot'un tablosunu getiriyordu; bu da Spring Cloud'unkini getirir. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Bagimlilik aciklari. Yasam dongusune BAGLI DEGIL: acikca
                 cagrilinca calisir (mvn dependency-check:check), boylece gunluk
                 test kosusu yavaslamaz. Ilk kosu NVD veritabanini indirir.
                 NVD_API_KEY tanimliysa cok daha hizlidir; anahtarsiz da calisir. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <!-- Bu projede .NET ve Node yok; arayuz npm audit ile bakiliyor. -->
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                    <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                    <!-- Sonatype OSS Index artik anonim istege 401 donuyor ve
                         cozumleyici hatasi TARAMAYI DUSURUYORDU. Kapali: veri
                         kaynagimiz NVD. Hesap alinirsa geri acilabilir. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                </configuration>
            </plugin>
            <!-- "mvn spring-boot:run" komutunu ve calistirilabilir jar uretimini saglar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- build-info: derleme sirasinda surum, artifact ve zaman
                         damgasini META-INF'e yazar; /actuator/info bunu doner.
                         Onceden uc ACIKTI ama BOSTU: calisan bir konteynere
                         "sen hangi surumsun" diye sorulamiyordu. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
