<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Employee Service ile ortak parent POM yoktur: her servis bagimsiz
         derlenir ve dagitilir. Ortak parent, bagimsizligi kagit uzerinde
         birakip surum yukseltmelerini birbirine baglardi. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.proje</groupId>
    <artifactId>notification-service</artifactId>
    <version>1.0.0</version>
    <name>notification-service</name>
    <description>Consumes employee events and sends notification mails</description>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <!-- Guvenlik taramasi eklentisi; parent tarafindan yonetilmiyor. -->
        <dependency-check.version>12.1.3</dependency-check.version>
        <!-- Kapsam olcumu. Boot 3.5 bunu surum tablosunda tutmuyor. -->
        <jacoco.version>0.8.15</jacoco.version>
        <!-- Override GERI KONDU: 10.1.55'te dort CVSS 9.1 var (CVE-2026-53434,
             CVE-2026-55276, CVE-2026-59083, CVE-2026-59084) ve son ikisi ancak
             10.1.57'de kapaniyor.
             KALDIRMA KOSULU: Boot'un surum tablosu 10.1.57'yi gectiginde. -->
        <tomcat.version>10.1.57</tomcat.version>

        <!-- CVE-2026-54291: 42.7.4 ile 42.7.11 arasinda `channelBinding=require`
             baglantilari SESSIZCE duz SCRAM'e dusebiliyor ve ortadaki adam
             korumasi kayboluyor. CVSSv4'te 8,2; CVSSv3'te 5,9. Kapi YUKSEK
             olana bakiyor: esik 8 yapilip kirilarak olculdu.

             Bu kurulumda somurulebilir DEGIL: baglanti adreslerinde ne
             `channelBinding` var ne `sslmode`. Yine de yamali hatta
             cekiliyor, cunku yama seviyesi bir adim ve acik gercek.

             Surum Boot'un tablosundan geliyordu; override tomcat ve
             httpclient5'teki desenin ayni. -->
        <postgresql.version>42.7.12</postgresql.version>
        <!-- CVE-2026-71290 (9.1): async HttpClient'ta TLS sunucu adi
             dogrulamasi etkisiz; 5.6.4 duzeltiyor. -->
        <httpclient5.version>5.6.4</httpclient5.version>
        <!-- httpcore5 istemciyle BIRLIKTE yukseltilir; ayrisirlarsa calisma
             zamaninda NoClassDefFoundError firliyor ve Feign sessizce
             calismiyor. Gerekce employee-service/pom.xml'de. -->
        <httpcore5.version>5.4.3</httpcore5.version>
    </properties>

    <dependencies>

        <!-- 1) RabbitMQ: bu servisin varlik sebebi, kuyruktan olay tuketmek. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- 2) Mail gonderimi: JavaMailSender ve SMTP istemcisi. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- 3) Veritabani erisimi: islenen olaylarin kaydi icin.
             Bu servisin kendi veritabani vardir (notification_db). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway 10'dan beri veritabani destegi ayri modullerde. Boot 3.5
             Flyway 11 getiriyor ve bu modul olmadan uygulama "Unsupported
             Database: PostgreSQL 16" diyerek HIC acilmiyor. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- 4) Eureka'ya kaydolmak. Feign hedefi adresle degil isimle bulur. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- 5) OpenFeign: Employee Service'e HTTP cagrisi, arayuz yazarak. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- 6) Actuator ve gomulu web sunucusu.
             Bu servisin disariya acilan bir REST API'si yoktur; web sunucusu
             yalnizca saglik ucunu HTTP uzerinden sunmak icindir. Actuator tek
             basina sunucu getirmez, bu yuzden starter-web de gerekir. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- Micrometer'in Prometheus bicimi. runtime: kod bu kutuphaneye
                 hic bakmaz, yalnizca /actuator/prometheus ucunu var eder. -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Bagimlilik aciklari. Yasam dongusune BAGLI DEGIL: acikca
                 cagrilinca calisir (mvn dependency-check:check), boylece gunluk
                 test kosusu yavaslamaz. Ilk kosu NVD veritabanini indirir.
                 NVD_API_KEY tanimliysa cok daha hizlidir; anahtarsiz da calisir. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <!-- Bu projede .NET ve Node yok; arayuz npm audit ile bakiliyor. -->
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                    <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                    <!-- Sonatype OSS Index artik anonim istege 401 donuyor ve
                         cozumleyici hatasi TARAMAYI DUSURUYORDU. Kapali: veri
                         kaynagimiz NVD. Hesap alinirsa geri acilabilir. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <!-- Kritik bulgu goruldugunde tarama DUSER. Esigin gerekcesi
                         ve sikilastirma kosulu employee-service/pom.xml'de. -->
                    <failBuildOnCVSS>9</failBuildOnCVSS>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                </configuration>
            </plugin>

            <!-- Test kapsami. Esik YOK; gerekce employee-service/pom.xml'de. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>instrument</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>**/*Application.class</exclude>
                        <exclude>**/event/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- build-info: derleme sirasinda surum, artifact ve zaman
                         damgasini META-INF'e yazar; /actuator/info bunu doner.
                         Onceden uc ACIKTI ama BOSTU: calisan bir konteynere
                         "sen hangi surumsun" diye sorulamiyordu. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
